# Exemple de configuration d'environnement - 11ème Heure Tabernacle
# 1. Clé ImgBB pour l'hébergement des photos
IMGBB_API_KEY=votre_cle_api_imgbb_ici

# 2. Token GitHub (Option A) pour sauvegarder automatiquement les modifications à vie en production
GITHUB_TOKEN=ghp_votre_token_personnel_ici
GITHUB_REPO=tychiquebongo-dev/11eheuretabernacle
GITHUB_BRANCH=main

# 3. Sécurité & Authentification du Back Office pastoral
# Mot de passe ou code PIN personnalisable à tout moment
ADMIN_PASSWORD=votre_mot_de_passe_secret_ici
ADMIN_PIN=1177
